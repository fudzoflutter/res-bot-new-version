# ===========================================================================
# TEMPLATE ONLY — copy this file to ".env" (or "env.txt") and fill in YOUR
# own values.
#
#     Windows:      copy .env.example .env
#     Linux/macOS:  cp .env.example .env
#
# NEVER commit real values: no bot tokens, passwords, API keys or database
# URLs.  Every value below is an EMPTY (or harmless default) placeholder.
#
# STAGING vs PRODUCTION
# ---------------------
# The SAME code runs in both environments; only these variables differ.
# Create two Railway environments and give EACH its own values:
#
#              STAGING                        PRODUCTION
#   BOT_TOKEN  separate test bot (@BotFather)  live bot
#   ADMIN_ID   your own ID (safe testing)      your own ID
#   DB_PATH    staging.db                      bot.db
#   SUPABASE   staging Supabase project        production Supabase project
#   WEBAPP_URL staging WebApp URL              production WebApp URL
#   ENVIRONMENT=staging                        ENVIRONMENT=production
#
# Never point a staging deploy at the production database.
# ===========================================================================

# --- REQUIRED --------------------------------------------------------------
# Token of YOUR bot (the bot users connect via Telegram Business).
# @BotFather -> /mybots -> API Token.
BOT_TOKEN=

# Your personal Telegram numeric ID (the bot OWNER).
# @userinfobot or @getmyid_bot.
ADMIN_ID=

# --- STORAGE ---------------------------------------------------------------
# Supabase Dashboard -> Connect -> "Connection pooling" -> copy the URI and
# put it HERE (a full postgresql:// URI belongs in SUPABASE_DB_URL, not in
# DB_PATH).  Leave empty to run on local SQLite.
SUPABASE_DB_URL=

# Local fallback SQLite file (used only when SUPABASE_DB_URL is empty).
DB_PATH=bot.db

# --- WEB ADMIN PANEL -------------------------------------------------------
# Telegram WebApp (TMA) URL opened by the panel's "TMA (Web Panel)" button.
# Leave empty to use the built-in default.
WEBAPP_URL=

# --- ENVIRONMENT -----------------------------------------------------------
# production | staging | development.  Drives warnings and log labels only —
# no behaviour is hardcoded per environment.
# ENVIRONMENT=production

# HTTP port for the Web Admin + healthcheck (/health, /ready).
# Railway sets PORT automatically; the default is 8080.
# PORT=8080

# --- OPTIONAL --------------------------------------------------------------
# Extra ADMINs (read/manage: statistics, monitoring, logs, enable/disable).
# ADMIN_IDS=
# Extra OWNERs (destructive: remove connection, clear cache/logs, retention,
# hold mode, admin management).  Keep this list short.
# ADMIN_OWNER_IDS=
# Emergency diagnostics only: lets a second copy poll Telegram.
# FORCE_POLL=0
